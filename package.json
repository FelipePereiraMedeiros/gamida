{
  "name": "gamida",
  "version": "2.38.0",
  "description": "Treinador Autônomo de Idiomas Bíblicos (Hebraico & Grego Koiné)",
  "main": "js/app.js",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File .\\serve.ps1 -Port 8080",
    "start": "powershell -ExecutionPolicy Bypass -File .\\serve.ps1 -Port 8080",
    "test": "node test-runner.js",
    "test:unit": "node test-runner.js all",
    "test:browser": "echo Abra test-environment.html em seu navegador",
    "build:bundle": "node scripts/build-bundle.js",
    "build:css": "node scripts/build-css.js",
    "test:py": "node scripts/run-py-tests.js",
    "e2e": "node tests/e2e/run.js",
    "test:all": "node test-runner.js all && node scripts/run-py-tests.js && node tests/e2e/run.js",
    "cronicas:arte": "node scripts/cronicas/extrair-arte.js"
