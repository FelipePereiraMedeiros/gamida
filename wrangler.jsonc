// Publicação no Cloudflare como Worker com arquivos estáticos (sem código de servidor).
// O Cloudflare roda "npm run build" (monta dist/) e depois "npx wrangler deploy", que publica dist/.
// O _headers dentro de dist/ traz os cabeçalhos de segurança e de cache.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gamida",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Serve cada arquivo pelo nome exato (index.html, oauth-callback.html...), sem redirecionar
    // para o endereço sem ".html": o service worker não pode guardar respostas redirecionadas,
    // e o retorno do login precisa ser exatamente o endereço registrado no Google.
    "html_handling": "none",
    // A raiz "/" (e só navegações a páginas que não existem) recebe o index.html
    "not_found_handling": "single-page-application"
  }
}
